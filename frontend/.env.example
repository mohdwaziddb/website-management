# Root domain (hamara product). Local: localhost, Live: yourdomain.com
#   localhost:5173 / yourdomain.com              = marketing site,   /admin = super admin
#   abc.localhost:5173 / abc.yourdomain.com      = client website,   /admin = us website ka admin
#   xyz.com (client ka apna domain)              = client website,   /admin = us website ka admin
VITE_BASE_DOMAIN=localhost

# API hamesha same-origin "/api" (vite proxy / nginx) — backend Host header se website pehchanta hai.
VITE_API_BASE_URL=/api

# Uploaded files ka origin (API alag domain par ho tab hi bharein)
VITE_FILES_BASE_URL=

# Marketing site par product ka naam + contact email
VITE_PRODUCT_NAME=Website Manager
VITE_CONTACT_EMAIL=
